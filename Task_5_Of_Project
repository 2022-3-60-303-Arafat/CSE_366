hlib import Path\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import classification_report, confusion_matrix\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport itertools\nimport tensorflow as tf\nfrom tensorflow.keras import layers, models, callbacks, optimizers, regularizers\nfrom tensorflow.keras.preprocessing.image import ImageDataGenerator\n\n# ---------------- USER / ENV SETTINGS ----------------\nDATA_DIR = \"/kaggle/input/plantdisease/PlantVillage\"        # read-only on Kaggle\nOUT_DIR = \"/kaggle/working/subset_dataset\"     # writable working dir\nMODEL_PATH = \"/kaggle/working/custom_cnn_tomato_best_256.h5\"\nIMG_SIZE = (256, 256)   # <-- changed to 256x256\nBATCH_SIZE = 32\nRANDOM_SEED = 1\nVAL_RATIO = 0.10   # final desired proportion of total\nTEST_RATIO = 0.20\nTRAIN_RATIO = 0.70\nEPOCHS = 30\nINITIAL_LR = 1e-3\nWEIGHT_DECAY = 1e-4\nDROPOUT_RATE = 0.4\n# ----------------------------------------------------\n\n# exact tomato classes (saved preference)\ntomato_classes = [\n    'Tomato_Bacterial_spot',\n    'Tomato_Early_blight',\n    'Tomato_Late_blight',\n    'Tomato_Leaf_Mold',\n    'Tomato_Septoria_leaf_spot',\n    'Tomato_Spider_mites_Two_spotted_spider_mite',\n    'Tomato__Target_Spot',\n    'Tomato__Tomato_YellowLeaf__Curl_Virus',\n    'Tomato__Tomato_mosaic_virus',\n    'Tomato_healthy'\n]\n\n# reproducibility\nrandom.seed(RANDOM_SEED)\nnp.random.seed(RANDOM_SEED)\ntf.random.set_seed(RANDOM_SEED)\n\nPath(OUT_DIR).mkdir(parents=True, exist_ok=True)\n\n# 0) verify classes exist in DATA_DIR\navailable = [d for d in sorted(os.listdir(DATA_DIR)) if os.path.isdir(os.path.join(DATA_DIR, d))]\nmissing = [c for c in tomato_classes if c not in available]\nif missing:\n    print(\"Warning: the following requested classes were NOT found under\", DATA_DIR)\n    for m in missing:\n        print(\"  -\", m)\nselected = [c for c in tomato_classes if c in available]\nif len(selected) == 0:\n    raise SystemExit(\"No requested tomato classes exist under DATA_DIR. Check names.\")\nprint(\"Using classes ({}):\".format(len(selected)))\nfor c in selected:\n    print(\" -\", c)\n\n# 1) Create train/val/test splits per class and copy files\ndef prepare_train_val_test(data_dir, out_dir, classes, train_ratio=0.7, val_ratio=0.1, test_ratio=0.2, seed=42):\n    assert abs(train_ratio + val_ratio + test_ratio - 1.0) < 1e-6\n    out_train = os.path.join(out_dir, \"train\")\n    out_val = os.path.join(out_dir, \"val\")\n    out_test = os.path.join(out_dir, \"test\")\n    Path(out_train).mkdir(parents=True, exist_ok=True)\n    Path(out_val).mkdir(parents=True, exist_ok=True)\n    Path(out_test).mkdir(parents=True, exist_ok=True)\n\n    for cls in classes:\n        src_dir = os.path.join(data_dir, cls)\n        images = sorted(glob(os.path.join(src_dir, \"*\")))\n        images = [p for p in images if p.lower().endswith(('.jpg','.jpeg','.png','.bmp'))]\n        n = len(images)\n        if n == 0:\n            print(f\"Skipping {cls} — no images found.\")\n            continue\n\n        # Step 1: split off test (test_ratio)\n        test_size = test_ratio\n        rest_size = 1.0 - test_size\n        images_trainval, images_test = train_test_split(images, test_size=test_size, random_state=seed, shuffle=True)\n\n        # Step 2: from the remaining, compute val fraction (val_ratio / rest_size)\n        if rest_size <= 0:\n            images_train, images_val = [], []\n        else:\n            val_frac_of_rest = val_ratio / rest_size  # e.g., 0.1 / 0.8 = 0.125\n            images_train, images_val = train_test_split(images_trainval, test_size=val_frac_of_rest, random_state=seed, shuffle=True)\n\n        # Copy files to corresponding folders\n        dst_train_cls = os.path.join(out_train, cls); Path(dst_train_cls).mkdir(parents=True, exist_ok=True)\n        dst_val_cls = os.path.join(out_val, cls); Path(dst_val_cls).mkdir(parents=True, exist_ok=True)\n        dst_test_cls = os.path.join(out_test, cls); Path(dst_test_cls).mkdir(parents=True, exist_ok=True)\n\n        for f in images_train:\n            shutil.copy(f, dst_train_cls)\n        for f in images_val:\n            shutil.copy(f, dst_val_cls)\n        for f in images_test:\n            shutil.copy(f, dst_test_cls)\n\n        print(f\"Class {cls}: total={n}, train={len(images_train)}, val={len(images_val)}, test={len(images_test)}\")\n    return out_train, out_val, out_test\n\ntrain_folder, val_folder, test_folder = prepare_train_val_test(DATA_DIR, OUT_DIR, selected, TRAIN_RATIO, VAL_RATIO, TEST_RATIO, RANDOM_SEED)\n\n# quick totals\ndef folder_count(folder):\n    total = 0\n    for root, dirs, files in os.walk(folder):\n        total += len([f for f in files if f.lower().endswith(('.jpg','.jpeg','.png','.bmp'))])\n    return total\n\nprint(\"Totals -> train:\", folder_count(train_folder), \" val:\", folder_count(val_folder), \" test:\", folder_count(test_folder))\n\n# 2) Data augmentation & generators (with 256x256 target size)\ntrain_datagen = ImageDataGenerator(\n    rescale=1./255,\n    rotation_range=20,\n    width_shift_range=0.12,\n    height_shift_range=0.12,\n    shear_range=0.08,\n    zoom_range=0.12,\n    horizontal_flip=True,\n    brightness_range=(0.8, 1.2),\n    fill_mode='nearest'\n)\n\nval_datagen = ImageDataGenerator(rescale=1./255)\ntest_datagen = ImageDataGenerator(rescale=1./255)\n\ntrain_gen = train_datagen.flow_from_directory(\n    train_folder,\n    target_size=IMG_SIZE,\n    batch_size=BATCH_SIZE,\n    class_mode='categorical',\n    shuffle=True\n)\nval_gen = val_datagen.flow_from_directory(\n    val_folder,\n    target_size=IMG_SIZE,\n    batch_size=BATCH_SIZE,\n    class_mode='categorical',\n    shuffle=False\n)\ntest_gen = test_datagen.flow_from_directory(\n    test_folder,\n    target_size=IMG_SIZE,\n    batch_size=BATCH_SIZE,\n    class_mode='categorical',\n    shuffle=False\n)\n\nnum_classes = len(train_gen.class_indices)\nprint(\"Num classes (subset):\", num_classes)\nprint(\"Class indices:\", train_gen.class_indices)\n\n# 3) Optional class weights for imbalance\nfrom sklearn.utils.class_weight import compute_class_weight\ny_train = train_gen.classes\nclass_weights = compute_class_weight(class_weight='balanced', classes=np.unique(y_train), y=y_train)\nclass_weight_dict = {i: float(w) for i, w in enumerate(class_weights)}\nprint(\"Class weights:\", class_weight_dict)\n\n# 4) Build custom CNN (input adjusted for 256x256)\ndef build_custom_cnn(input_shape=(256,256,3), num_classes=10, dropout_rate=0.4, weight_decay=0.0):\n    inp = layers.Input(shape=input_shape)\n\n    # Block 1\n    x = layers.Conv2D(32, (3,3), padding='same', kernel_initializer='he_normal')(inp)\n    x = layers.BatchNormalization()(x)\n    x = layers.Activation('relu')(x)\n    x = layers.Conv2D(32, (3,3), padding='same', kernel_initializer='he_normal')(x)\n    x = layers.BatchNormalization()(x)\n    x = layers.Activation('relu')(x)\n    x = layers.MaxPooling2D((2,2))(x)\n    x = layers.Dropout(0.15)(x)\n\n    # Block 2\n    x = layers.Conv2D(64, (3,3), padding='same', kernel_initializer='he_normal')(x)\n    x = layers.BatchNormalization()(x)\n    x = layers.Activation('relu')(x)\n    x = layers.Conv2D(64, (3,3), padding='same', kernel_initializer='he_normal')(x)\n    x = layers.BatchNormalization()(x)\n    x = layers.Activation('relu')(x)\n    x = layers.MaxPooling2D((2,2))(x)\n    x = layers.Dropout(0.2)(x)\n\n    # Block 3\n    x = layers.Conv2D(128, (3,3), padding='same', kernel_initializer='he_normal')(x)\n    x = layers.BatchNormalization()(x)\n    x = layers.Activation('relu')(x)\n    x = layers.Conv2D(128, (3,3), padding='same', kernel_initializer='he_normal')(x)\n    x = layers.BatchNormalization()(x)\n    x = layers.Activation('relu')(x)\n    x = layers.MaxPooling2D((2,2))(x)\n    x = layers.Dropout(0.25)(x)\n\n    # Block 4\n    x = layers.Conv2D(256, (3,3), padding='same', kernel_initializer='he_normal')(x)\n    x = layers.BatchNormalization()(x)\n    x = layers.Activation('relu')(x)\n    x = layers.Conv2D(256, (3,3), padding='same', kernel_initializer='he_normal')(x)\n    x = layers.BatchNormalization()(x)\n    x = layers.Activation('relu')(x)\n    x = layers.MaxPooling2D((2,2))(x)\n    x = layers.Dropout(0.3)(x)\n\n    # Global pooling + FC head\n    x = layers.GlobalAveragePooling2D()(x)\n    x = layers.Dense(512, kernel_regularizer=regularizers.l2(weight_decay))(x)\n    x = layers.BatchNormalization()(x)\n    x = layers.Activation('relu')(x)\n    x = layers.Dropout(dropout_rate)(x)\n\n    x = layers.Dense(256, kernel_regularizer=regularizers.l2(weight_decay))(x)\n    x = layers.BatchNormalization()(x)\n    x = layers.Activation('relu')(x)\n    x = layers.Dropout(dropout_rate)(x)\n\n    out = layers.Dense(num_classes, activation='softmax')(x)\n\n    model = models.Model(inputs=inp, outputs=out)\n    return model\n\nmodel = build_custom_cnn(input_shape=IMG_SIZE + (3,), num_classes=num_classes, dropout_rate=DROPOUT_RATE, weight_decay=WEIGHT_DECAY)\nmodel.summary()\n\n# 5) Compile\nopt = optimizers.Adam(learning_rate=INITIAL_LR)\nmodel.compile(optimizer=opt, loss='categorical_crossentropy', metrics=['accuracy'])\n\n# 6) Callbacks\nckpt = callbacks.ModelCheckpoint(MODEL_PATH, monitor='val_accuracy', save_best_only=True, verbose=1)\nrlr = callbacks.ReduceLROnPlateau(monitor='val_loss', factor=0.5, patience=3, verbose=1)\nes = callbacks.EarlyStopping(monitor='val_loss', patience=7, restore_best_weights=True, verbose=1)\n\n# ---------------- REPLACEMENT: Train, evaluate, metrics, ROC, timings, paired t-test ----------------\n\nfrom sklearn.metrics import (classification_report, confusion_matrix,\n                             precision_recall_fscore_support, accuracy_score,\n                             roc_auc_score, roc_curve, auc)\nfrom sklearn.preprocessing import label_binarize\nfrom scipy.stats import ttest_rel\nimport time\n\n# 7) Train (monitor validation set) — measure training time\nsteps_per_epoch = int(np.ceil(train_gen.samples / train_gen.batch_size))\nvalidation_steps = int(np.ceil(val_gen.samples / val_gen.batch_size))\n\nprint(\"Starting training...\")\ntrain_start = time.time()\nhistory = model.fit(\n    train_gen,\n    epochs=EPOCHS,\n    steps_per_epoch=steps_per_epoch,\n    validation_data=val_gen,\n    validation_steps=validation_steps,\n    callbacks=[ckpt, rlr, es],\n    class_weight=class_weight_dict\n)\ntrain_end = time.time()\ntrain_time = train_end - train_start\nprint(f\"Training finished. Training time: {train_time:.2f} seconds ({train_time/60:.2f} minutes)\")\n\n# 8) Evaluate on TEST set (load best model) and measure inference time\nmodel.load_weights(MODEL_PATH)\ntest_steps = int(np.ceil(test_gen.samples / test_gen.batch_size))\n\nprint(\"Running inference on test set...\")\ntest_start = time.time()\ny_pred_probas = model.predict(test_gen, steps=test_steps, verbose=1)\ntest_end = time.time()\ntest_time = test_end - test_start\nprint(f\"Inference finished. Test (inference) time for full test set: {test_time:.4f} seconds\")\n\n# predicted classes\nif y_pred_probas.ndim == 1 or (y_pred_probas.ndim == 2 and y_pred_probas.shape[1] == 1):\n    # binary-ish output -> threshold\n    y_pred_classes = (y_pred_probas.ravel() > 0.5).astype(int)\nelse:\n    y_pred_classes = np.argmax(y_pred_probas, axis=1)\n\ny_true = np.array(test_gen.classes)\nclass_names = list(test_gen.class_indices.keys())\nlabels = np.unique(y_true)\nnum_classes = len(class_names)\n\nprint(\"\\n=== TEST SET RESULTS ===\\n\")\nprint(\"Test samples:\", test_gen.samples)\nprint(\"Num classes:\", num_classes)\nprint(\"Class indices:\", test_gen.class_indices)\n\n# Overall accuracy\noverall_acc = accuracy_score(y_true, y_pred_classes)\nprint(f\"\\nOverall Accuracy: {overall_acc:.4f}\")\n\n# Per-class accuracy\nper_class_acc = {}\nfor lbl in labels:\n    idx = np.where(y_true == lbl)[0]\n    if len(idx) == 0:\n        per_class_acc[lbl] = np.nan\n    else:\n        per_class_acc[lbl] = np.mean(y_pred_classes[idx] == y_true[idx])\nprint(\"\\nPer-class accuracy (label: accuracy):\")\nfor lbl in labels:\n    cname = class_names[lbl] if lbl < len(class_names) else str(lbl)\n    print(f\"  {lbl} ({cname}): {per_class_acc[lbl]:.4f}\")\n\n# Precision/Recall/F1 per-class and macro/micro\nprec, rec, f1, sup = precision_recall_fscore_support(y_true, y_pred_classes, average=None, zero_division=0)\npr_df = pd.DataFrame({\n    'class_index': labels,\n    'class_name': [class_names[i] for i in labels],\n    'precision': prec,\n    'recall': rec,\n    'f1-score': f1,\n    'support': sup\n})\nprint(\"\\nPer-class precision / recall / f1 / support:\")\ndisplay(pr_df)\n\nmacro_prec, macro_rec, macro_f1, _ = precision_recall_fscore_support(y_true, y_pred_classes, average='macro', zero_division=0)\nmicro_prec, micro_rec, micro_f1, _ = precision_recall_fscore_support(y_true, y_pred_classes, average='micro', zero_division=0)\nprint(f\"\\nMacro Precision: {macro_prec:.4f}, Macro Recall: {macro_rec:.4f}, Macro F1: {macro_f1:.4f}\")\nprint(f\"Micro Precision: {micro_prec:.4f}, Micro Recall: {micro_rec:.4f}, Micro F1: {micro_f1:.4f}\")\n\n# Confusion matrix & classification report\ncm = confusion_matrix(y_true, y_pred_classes, labels=labels)\nprint(\"\\nConfusion Matrix:\")\ndisplay(pd.DataFrame(cm, index=[f\"true_{class_names[i]}\" for i in labels],\n                     columns=[f\"pred_{class_names[i]}\" for i in labels]))\n\nprint(\"\\nClassification Report:\")\nprint(classification_report(y_true, y_pred_classes, target_names=[class_names[i] for i in labels], zero_division=0))\n\n# ---------- AUC & ROC (one-vs-rest for multiclass) ----------\ntry:\n    if num_classes == 2:\n        # binary\n        if y_pred_probas.ndim > 1 and y_pred_probas.shape[1] > 1:\n            pos_prob = y_pred_probas[:, 1]\n        else:\n            pos_prob = y_pred_probas.ravel()\n        auc_score = roc_auc_score(y_true, pos_prob)\n        fpr, tpr, _ = roc_curve(y_true, pos_prob)\n        print(f\"\\nROC AUC (binary): {auc_score:.4f}\")\n        plt.figure()\n        plt.plot(fpr, tpr, lw=2, label=f'AUC = {auc_score:.3f}')\n        plt.plot([0,1],[0,1], linestyle='--')\n        plt.xlabel('False Positive Rate'); plt.ylabel('True Positive Rate'); plt.title('ROC Curve (binary)')\n        plt.legend(loc='lower right'); plt.show()\n    else:\n        # multiclass: one-vs-rest\n        y_true_bin = label_binarize(y_true, classes=labels)  # shape (n_samples, n_classes)\n        if y_pred_probas.shape[1] != len(labels):\n            raise ValueError(f\"y_pred_probas shape {y_pred_probas.shape} doesn't match number of classes {len(labels)}\")\n        fpr = dict(); tpr = dict(); roc_auc = dict()\n        for i, lab in enumerate(labels):\n            fpr[i], tpr[i], _ = roc_curve(y_true_bin[:, i], y_pred_probas[:, i])\n            roc_auc[i] = auc(fpr[i], tpr[i])\n        # micro-average\n        fpr[\"micro\"], tpr[\"micro\"], _ = roc_curve(y_true_bin.ravel(), y_pred_probas.ravel())\n        roc_auc[\"micro\"] = auc(fpr[\"micro\"], tpr[\"micro\"])\n        # macro-average\n        all_fpr = np.unique(np.concatenate([fpr[i] for i in range(len(labels))]))\n        mean_tpr = np.zeros_like(all_fpr)\n        for i in range(len(labels)):\n            mean_tpr += np.interp(all_fpr, fpr[i], tpr[i])\n        mean_tpr /= len(labels)\n        fpr[\"macro\"] = all_fpr\n        tpr[\"macro\"] = mean_tpr\n        roc_auc[\"macro\"] = auc(fpr[\"macro\"], tpr[\"macro\"])\n\n        print(\"\\nAUC per class:\")\n        for i, lab in enumerate(labels):\n            print(f\"  {lab} ({class_names[lab]}): AUC = {roc_auc[i]:.4f}\")\n        print(f\"micro-average AUC: {roc_auc['micro']:.4f}\")\n        print(f\"macro-average AUC: {roc_auc['macro']:.4f}\")\n\n        # Plot ROC curves\n        plt.figure(figsize=(9,7))\n        plt.plot(fpr[\"micro\"], tpr[\"micro\"], label=f'micro-average ROC (AUC = {roc_auc[\"micro\"]:.3f})', linewidth=2)\n        plt.plot(fpr[\"macro\"], tpr[\"macro\"], label=f'macro-average ROC (AUC = {roc_auc[\"macro\"]:.3f})', linewidth=2, linestyle='--')\n        for i, lab in enumerate(labels):\n            plt.plot(fpr[i], tpr[i], lw=1, label=f'{class_names[lab]} (AUC = {roc_auc[i]:.3f})')\n        plt.plot([0,1],[0,1],'k--', lw=0.8)\n        plt.xlabel('False Positive Rate'); plt.ylabel('True Positive Rate'); plt.title('Multi-class ROC curves')\n        plt.legend(loc='lower right', fontsize='small'); plt.show()\nexcept Exception as e:\n    print(\"Could not compute ROC/AUC:\", e)\n\n# 9) Plot confusion matrix and training curves (reuse your plotting function)\ndef plot_confusion_matrix(cm, class_names):\n    plt.figure(figsize=(10,10))\n    plt.imshow(cm, interpolation='nearest', cmap=plt.cm.Blues)\n    plt.title(\"Confusion matrix (test set)\")\n    plt.colorbar()\n    ticks = np.arange(len(class_names))\n    plt.xticks(ticks, class_names, rotation=90)\n    plt.yticks(ticks, class_names)\n    fmt = 'd'\n    thresh = cm.max() / 2. if cm.size>0 else 0\n    for i, j in itertools.product(range(cm.shape[0]), range(cm.shape[1])):\n        plt.text(j, i, format(cm[i, j], fmt),\n                 horizontalalignment=\"center\",\n                 color=\"white\" if cm[i, j] > thresh else \"black\")\n    plt.tight_layout()\n    plt.show()\n\nplot_confusion_matrix(cm, [class_names[i] for i in labels])\n\n# Plot train/val curves\nplt.figure(figsize=(12,4))\nplt.subplot(1,2,1)\nplt.plot(history.history.get('loss', []), label='train_loss')\nplt.plot(history.history.get('val_loss', []), label='val_loss')\nplt.legend(); plt.title('Loss')\nplt.subplot(1,2,2)\nplt.plot(history.history.get('accuracy', []), label='train_acc')\nplt.plot(history.history.get('val_accuracy', []), label='val_acc')\nplt.legend(); plt.title('Accuracy')\nplt.show()\n\nprint(\"Best model saved to:\", MODEL_PATH)\nprint(\"Subset data at:\", OUT_DIR)\nprint(f\"Training time (s): {train_time:.2f}, Test inference time (s): {test_time:.4f}\")\n\n# --------------- Paired t-