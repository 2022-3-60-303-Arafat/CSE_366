,"execution_count":4},{"cell_type":"code","source":"# ======================================================\n#  Task 5.1 – Robust Grad-CAM setup (use model_gc)\n# ======================================================\nimport cv2\nfrom tensorflow.keras.preprocessing import image\nfrom tensorflow.keras.layers import Conv2D\n\nprint(\"\\n[Grad-CAM] Using model_gc for explainability.\")\n\n# 1) Find LAST Conv2D layer by type, not by shape\ndef find_last_conv_layer(model):\n    for layer in reversed(model.layers):\n        if isinstance(layer, Conv2D):\n            return layer.name\n    raise ValueError(\"No Conv2D layer found in model. Check architecture.\")\n\nlast_conv_layer_name = find_last_conv_layer(model_gc)\nprint(\"Last Conv2D layer selected for Grad-CAM:\", last_conv_layer_name)\n\n# 2) Preprocessing (same as training)\ndef load_and_prep(path, target_size=IMG_SIZE):\n    img = image.load_img(path, target_size=target_size)\n    arr = image.img_to_array(img).astype(\"float32\") / 255.0\n    return np.expand_dims(arr, 0), np.array(img, dtype=np.uint8)\n\n# 3) Grad-CAM core\ndef make_gradcam_heatmap(img_array, model, last_conv_name, pred_index=None):\n    grad_model = tf.keras.models.Model(\n        [model.inputs],\n        [model.get_layer(last_conv_name).output, model.output]\n    )\n\n    with tf.GradientTape() as tape:\n        conv_output, preds = grad_model(img_array)\n        if pred_index is None:\n            pred_index = tf.argmax(preds[0])\n        class_score = preds[:, pred_index]\n\n    grads = tape.gradient(class_score, conv_output)\n    pooled_grads = tf.reduce_mean(grads, axis=(0, 1, 2))\n    conv_output = conv_output[0]\n\n    heatmap = conv_output @ pooled_grads[..., tf.newaxis]\n    heatmap = tf.squeeze(heatmap)\n    heatmap = tf.maximum(heatmap, 0) / (tf.reduce_max(heatmap) + 1e-8)\n\n    return heatmap.numpy()\n\n# 4) Overlay heatmap\ndef overlay_heatmap(img, heatmap, alpha=0.4):\n    heatmap = cv2.resize(heatmap, (img.shape[1], img.shape[0]))\n    heatmap = np.uint8(255 * heatmap)\n    heatmap = cv2.applyColorMap(heatmap, cv2.COLORMAP_JET)\n    return cv2.addWeighted(img, 1-alpha, heatmap, alpha, 0)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-16T17:05:25.152978Z","iopub.execute_input":"2025-12-16T17:05:25.153242Z","iopub.status.idle":"2025-12-16T17:05:25.163148Z","shell.execute_reply.started":"2025-12-16T17:05:25.153219Z","shell.execute_reply":"2025-12-16T17:05:25.162299Z"}},"outputs":[{"name":"stdout","text":"\n[Grad-CAM] Using model_gc for explainability.\nLast Conv2D layer selected for Grad-CAM: conv2d_15\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"# ======================================================\n#  Task 5.1 – Run Grad-CAM on test samples\n# ======================================================\n\n# Build list of paths from your existing split\ntest_image_paths = []\nclass_indices = test_gen.class_indices\ninv_class_indices = {v: k for k, v in class_indices.items()}\n\nfor cls_name in class_indices.keys():\n    cls_dir = os.path.join(test_folder, cls_name)\n    test_image_paths.extend(\n        glob(os.path.join(cls_dir, \"*.jpg\")) +\n        glob(os.path.join(cls_dir, \"*.jpeg\")) +\n        glob(os.path.join(cls_dir, \"*.png\"))\n    )\n\nprint(\"Total test images found:\", len(test_image_paths))\n\n# True labels\ntrue_labels_dict = {\n    p: class_indices[os.path.basename(os.path.dirname(p))]\n    for p in test_image_paths\n}\n\n# Grad-CAM on a random subset\nresults = []   # (path, true_idx, pred_idx, correct, overlay_img)\nsample_paths = random.sample(test_image_paths, min(60, len(test_image_paths)))\n\nprint(\"\\nComputing Grad-CAM heatmaps...\")\nfor p in sample_paths:\n    x, orig = load_and_prep(p)\n    preds = model_gc.predict(x, verbose=0)\n    pred_idx = int(np.argmax(preds[0]))\n    true_idx = true_labels_dict[p]\n    correct = (pred_idx == true_idx)\n\n    heatmap = make_gradcam_heatmap(x, model_gc, last_conv_layer_name, pred_index=pred_idx)\n    overlay = overlay_heatmap(orig, heatmap)\n\n    results.append((p, true_idx, pred_idx, correct, overlay))\n\ncorrect_samples = [r for r in results if r[3]]\nincorrect_samples = [r for r in results if not r[3]]\n\nprint(\"Grad-CAM samples -> Correct:\", len(correct_samples), \" Incorrect:\", len(incorrect_samples))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-16T17:05:25.163923Z","iopub.execute_input":"2025-12-16T17:05:25.164509Z","iopub.status.idle":"2025-12-16T17:05:33.844945Z","shell.execute_reply.started":"2025-12-16T17:05:25.164487Z","shell.execute_reply":"2025-12-16T17:05:33.844211Z"}},"outputs":[{"name":"stdout","text":"Total test images found: 35\n\nComputing Grad-CAM heatmaps...\n","output_type":"stream"},{"name":"stderr","text":"/usr/local/lib/python3.11/dist-packages/keras/src/models/functional.py:237: UserWarning: The structure of `inputs` doesn't match the expected structure.\nExpected: [['keras_tensor_43']]\nReceived: inputs=Tensor(shape=(1, 256, 256, 3))\n  warnings.warn(msg)\n","output_type":"stream"},{"name":"stdout","text":"Grad-CAM samples -> Correct: 34  Incorrect: 1\n","output_type":"stream"}],"execution_count":6},{"cell_type":"code","source":"# ======================================================\n#  Task 5.1 – Visualize Grad-CAM (Correct vs Incorrect)\n# ======================================================\n\n# show up to 6 correct + 6 incorrect\nto_show = correct_samples[:6] + incorrect_samples[:6]\nn = len(to_show)\ncols = 3\nrows = int(np.ceil(n / cols))\n\nplt.figure(figsize=(5*cols, 5*rows))\n\nfor i, (path_img, t_idx, p_idx, correct, overlay) in enumerate(to_show):\n    plt.subplot(rows, cols, i+1)\n    plt.imshow(overlay[:, :, ::-1])  # BGR -> RGB\n    title = f\"Pred: {inv_class_indices[p_idx]}\\nTrue: {inv_class_indices[t_idx]}\"\n    title += \"\\nCORRECT\" if correct else \"\\nINCORRECT\"\n    plt.title(title)\n    plt.axis(\"off\")\n\nplt.tight_layout()\nplt.show()\